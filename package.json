{
  "name": "combat-zone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "functions"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "benchmark:performance:browser": "vite --host 127.0.0.1",
    "preview": "vite preview",
    "test": "vitest run",
    "test:agent": "vitest run --reporter=agent",
    "test:emulator": "firebase emulators:exec --project demo-combat-zone --only firestore,storage \"vitest run --config vitest.emulator.config.ts --reporter=agent\"",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && npm run typecheck --workspace=@combat-zone/firebase-api && npm run typecheck --workspace=@combat-zone/functions",
    "test:firebase-api": "vitest run --reporter=agent tests/core/persistence/cloud",
    "build:functions": "npm run build --workspace=@combat-zone/functions"
  },
  "dependencies": {
    "@combat-zone/firebase-api": "0.1.0",
    "@reduxjs/toolkit": "^2.2.7",
    "firebase": "^12.2.1",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "path-browserify": "^1.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^20.16.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "firebase-tools": "^15.29.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=24.18.0",
    "npm": ">=11.16.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  }
}
